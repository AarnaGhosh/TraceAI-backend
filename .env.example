# Copy this file to .env for local development (not needed on HF Spaces -
# set these as "Secrets"/"Variables" in the Space settings instead)

# Secret key for signing JWTs - generate a random one, e.g. `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-string

# Leave unset to use local SQLite (traceai.db). Set to a Postgres URL for production, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/traceai
DATABASE_URL=sqlite:///./traceai.db

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=https://ai-missing-person-safety-app.vercel.app,http://localhost:3000
